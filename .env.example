# ============================================================
# Defiy OS — environment template
# Copy to .env (backend) and fill in. NEVER commit real keys.
# ============================================================

# --- Database -------------------------------------------------
# Defaults to local SQLite. Use Postgres in production:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/defiy

# --- Auth -----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# --- AI engine (Google Gemini) -------------------------------
# Server-side only — the key is NEVER exposed to the client.
# Without it, the app runs fully; the AI chat honestly reports
# that the engine is not connected, and explicit commands
# ("remind me to X at 7pm", "log my breakfast: ...") still work.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Push notifications ---------------------------------------
# Empty = reminders are stored, and the app clearly says push is
# not yet connected. Later set to "expo" or "fcm" once wired.
PUSH_PROVIDER=

# --- CORS -----------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
